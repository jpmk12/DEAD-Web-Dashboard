NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
ANTHROPIC_API_KEY=<from console.anthropic.com>
GMAIL_SECONDARY_REDIRECT_URI=http://localhost:3000/api/auth/gmail-secondary?step=callback
OWNER_EMAIL=<your Google account email — only this address can log in>

# Optional: live AIS for the OSINT maritime map. Free signup at
# https://aisstream.io issues a key. Without it, the maritime pane stays on
# the iframe providers (VesselFinder / MarineTraffic / OpenSeaMap).
AISSTREAM_API_KEY=

# Optional: ACLED structured conflict events for the Crisis map's "ACLED" layer
# (precise strikes/battles with sub-event type, actors, and fatalities).
# PREFERRED: set these in the app UI (Preferences → Sources & feeds → ACLED
# Strikes) — they're stored server-side per install. These env vars are an
# OPTIONAL OVERRIDE: when both are set they win over the UI value and the UI
# field becomes read-only (useful for pinning credentials at the deploy level).
# Register a free account at https://acleddata.com/register/ — ACLED's API uses
# a session-cookie login (account email + password), not an API key. Note the
# free tier embargoes data <12 months old, so the ACLED layer needs an account
# with recent-data access. Data © ACLED; attribution is required wherever shown.
ACLED_EMAIL=
ACLED_PASSWORD=

# Optional: UCDP token for the Crisis map's keyless "Conflict" layer (Uppsala
# Conflict Data Program GED — georeferenced battles/violence with coordinates +
# fatalities, ~1-month-lagged monthly candidate data). UCDP's API now requires a
# token, sent as the x-ucdp-access-token header. Request one from UCDP
# (ucdpapi.pcr.uu.se). Without it the "Conflict" layer is empty.
UCDP_API_TOKEN=
