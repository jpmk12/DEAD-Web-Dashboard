NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<run: openssl rand -base64 32>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
ANTHROPIC_API_KEY=<from console.anthropic.com>
GMAIL_SECONDARY_REDIRECT_URI=http://localhost:3000/api/auth/gmail-secondary?step=callback
OWNER_EMAIL=<your Google account email — only this address can log in>

# Optional: live AIS for the OSINT maritime map. Free signup at
# https://aisstream.io issues a key. Without it, the maritime pane stays on
# the iframe providers (VesselFinder / MarineTraffic / OpenSeaMap).
AISSTREAM_API_KEY=
